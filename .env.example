# Optional local database; never put secrets in VITE_ variables.
DATABASE_URL=sqlite:///agentguard.db
# No API keys are required. Backend defaults to loopback port 8000.
# Operator-controlled exact URLs for optional live user-agent assessments.
AGENTGUARD_ALLOWED_ENDPOINTS=
# Enable only when explicitly testing an approved loopback agent adapter.
AGENTGUARD_ALLOW_LOOPBACK=0
